{
  "name": "ytdl-desktop",
  "productName": "YTDL Desktop",
  "version": "1.0.0",
  "description": "Desktop UI for local yt-dlp channel sync, library, and playback",
  "author": "YTDL Desktop",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "bun ./scripts/generate-icon.mjs && bun ./scripts/run-electron-vite.mjs dev",
    "build": "bun ./scripts/generate-icon.mjs && electron-vite build",
    "start": "bun ./scripts/generate-icon.mjs && bun ./scripts/run-electron-vite.mjs preview",
    "icon:gen": "bun ./scripts/generate-icon.mjs",
    "pack": "bun run build && electron-builder --dir",
    "dist": "bun run build && electron-builder",
    "dist:win": "bun run build && electron-builder --win",
    "dist:mac": "bun run build && electron-builder --mac",
    "postinstall": "bun ./scripts/run-postinstall.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.0.0",
    "lucide-react": "^1.7.0",
    "motion": "^12.38.0",
    "music-metadata": "^11.12.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "dependencies": {
    "cn": "^0.5.0"
  }
}
