# --- Allow only known source at repo root (ignore ad-hoc channel / media dirs) ---
/*
!/.gitignore
!/README.md
!/LICENSE
!/AGENTS.md
!/desktop/
!/scripts/
!/examples/

# Editor / local
/.cursor/
.DS_Store

# Dependencies & build (inside desktop/)
desktop/node_modules/
desktop/out/
desktop/dist/

# Corporate TLS / local proxy wiring (not shared in git)
desktop/certs/
desktop/.npmrc
desktop/bunfig.toml
desktop/package-lock.json
desktop/src/main/corporate-ca.ts
desktop/src/main/undici.d.ts
desktop/scripts/resolve-corporate-ca.mjs
desktop/scripts/test-electron-ca.mjs
*.log

# User data at repository root only
/channels.txt
/downloaded.txt
/videos/
/rec/

# Stray media at repository root only
/*.mp4
/*.webm
/*.mkv
/*.m4a
/*.mp3
